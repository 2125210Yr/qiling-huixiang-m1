\"120\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_108/h_120/1069/92835/2022/11/2/224909.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_108/h_120/1069/92835/2022/11/2/224909.png\" style=\"font-weight:700;color:rgb(51,51,51);text-align:left;font-size:13.9999px;width:40px;height:44px;\"><span style=\"font-weight:700;color:rgb(51,51,51);text-align:left;font-size:13.9999px;\">活动配方</span><br></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\" style=\"\"><span style=\"font-weight: bold;\">活动期间开放<div class=\"div-img\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;text-align:left;\"><br></div><br></span></div>\n                               </div><br><div class=\"selectItem fold-model-container\" contenteditable=\"false\">\n                                \n                                <div class=\"fold-title-wrapper\">\n                                    <i class=\"icon-btn\"></i>\n                                    <div class=\"input-div\" contenteditable=\"true\" style=\"font-weight: bold;\"><img data-width=\"104\" data-height=\"120\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_104/h_120/1069/92835/2022/11/2/436319.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_104/h_120/1069/92835/2022/11/2/436319.png\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;width:40px;height:46px;\"><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\">装备配方</span><div class=\"div-img\"></div></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\" style=\"\"><div class=\"div-img\"><br></div><div class=\"div-img\"><span style=\"font-weight: bold;\">由地狱地铁出产的“<span style=\"color: rgb(255, 0, 0);\">天然石</span>”和由“<span style=\"color: rgb(255, 0, 0);\">天然石+精工石</span>”合成的“<span style=\"color: rgb(255, 0, 0);\">刻印石</span>”制作的全新装备</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><span style=\"color:rgb(0,0,0);font-size:13.9999px;font-weight:700;\">做新装备必经之路，</span><span style=\"color: rgb(255, 0, 0);\">装备的等级比较赌脸</span>，<span style=\"color: rgb(255, 0, 0);\">有机会</span>做出<span style=\"color: rgb(255, 0, 0);\">带S附魔的装备</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><span style=\"color: rgb(255, 0, 0);\"><br></span></span></div><div class=\"div-img\"><span style=\"font-weight: bold; color: initial;\">新装备带3个属性，C级以上就能换掉现有装备</span></div><div class=\"div-img\"><br></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/401968.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/401968.png\" style=\"width: 333px; height: 592px;\"></div><div class=\"div-img\"><br></div></div>\n                               </div><br><div class=\"selectItem fold-model-container\" contenteditable=\"false\">\n                                \n                                <div class=\"fold-title-wrapper\">\n                                    <i class=\"icon-btn\"></i>\n                                    <div class=\"input-div\" contenteditable=\"true\" style=\"font-weight: bold;\"><div class=\"div-img\"></div><img data-width=\"105\" data-height=\"120\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_105/h_120/1069/92835/2022/11/2/390827.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_105/h_120/1069/92835/2022/11/2/390827.png\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;width:40px;height:45px;\"><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\">召唤配方</span><br></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\"><div class=\"div-img\"><div class=\"div-img\"><span style=\"font-weight: bold;\"><div class=\"div-img\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"><span style=\"font-size: 0.37333rem;\">属性11连券：每周可以制作1张，前期材料够可以换来赌脸，后期没必要换</span><br></div></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">属性5星券：每月每属性2张，定属性赌，推荐换</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">属性5星温泉皮肤箱：也是赌脸，新手没必要，老手不需要，鸡肋</span></div><div class=\"div-img\"><br></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/57557.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/57557.png\" style=\"width: 333px; height: 585px;\"></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/624628.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/624628.png\" style=\"width: 333px; height: 592px;\"></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/285146.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/285146.png\" style=\"width: 333px; height: 592px;\"></div><br></div></div>\n                               </div><br><div class=\"selectItem fold-model-container\" contenteditable=\"false\">\n                                \n                                <div class=\"fold-title-wrapper\">\n                                    <i class=\"icon-btn\"></i>\n                                    <div class=\"input-div\" contenteditable=\"true\" style=\"font-weight: bold;\"><img data-width=\"103\" data-height=\"120\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_103/h_120/1069/92835/2022/11/2/550247.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_103/h_120/1069/92835/2022/11/2/550247.png\" style=\"font-weight:700;color:rgb(51,51,51);font-size:13.9999px;width:40px;height:46px;\"><span style=\"font-weight:700;color:rgb(51,51,51);font-size:13.9999px;\">魂卡配方</span><div class=\"div-img\"><div class=\"div-img\"></div></div></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\"><div class=\"div-img\"><span style=\"font-weight: bold;\"><div class=\"div-img\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"><span style=\"font-size: 0.37333rem;\">魂卡换枕头：属于游戏的回收机制了，垃圾5星可以每月兑换5个5星枕头</span><br></div></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">推荐新手按时来回收3、4星废卡，优先兑换5星魂卡和枕头</span></div><div class=\"div-img\"><br></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/272226.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/272226.png\" style=\"width: 333px; height: 592px;\"></div></div>\n                               </div><br><div class=\"selectItem fold-model-container\" contenteditable=\"false\">\n                                \n                                <div class=\"fold-title-wrapper\">\n                                    <i class=\"icon-btn\"></i>\n                                    <div class=\"input-div\" contenteditable=\"true\" style=\"font-weight: bold;\"><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"><div class=\"div-img\"><img data-width=\"115\" data-height=\"118\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_115/h_118/1069/92835/2022/11/2/872750.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_115/h_118/1069/92835/2022/11/2/872750.png\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;width:40px;height:41px;\"><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\">人偶配方</span><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"></span><br></div></span></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\"><div class=\"div-img\"><span style=\"font-weight: bold;\">人偶有两种制作方式：</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">一种为星云Boss出产的材料制作</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">一种为用现有的人偶回收兑换为新人偶，<span style=\"color: rgb(255, 0, 0);\">推荐回收兑换蓝色以上品质</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">人偶升级材料：</span></div><div class=\"div-img\"><span style=\"font-weight: bold; color: rgb(255, 0, 0);\">1、2星棉花为每周更新，3星棉花每月更新</span></div><div class=\"div-img\"><div class=\"div-img\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"><div class=\"div-img\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\"><br></div></div></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/137457.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/137457.png\" style=\"width: 333px; height: 592px;\"></div></div>\n                               </div><br><div class=\"selectItem fold-model-container active-item\" contenteditable=\"false\">\n                                \n                                <div class=\"fold-title-wrapper\">\n                                    <i class=\"icon-btn\"></i>\n                                    <div class=\"input-div\" contenteditable=\"true\" style=\"font-weight: bold;\"><img data-width=\"107\" data-height=\"109\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_107/h_109/1069/92835/2022/11/2/200747.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_107/h_109/1069/92835/2022/11/2/200747.png\" style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;width:40px;height:40px;\"><span style=\"color:rgb(51,51,51);font-size:13.9999px;font-weight:700;\">材料配方</span><br></div>\n                                </div>\n                                <div class=\"fold-content\" contenteditable=\"true\"><div class=\"div-img\"><span style=\"font-weight: bold;\">核心材料盒：每日任务出产的“<span style=\"color: rgb(255, 0, 0);\">核心粉尘”</span>兑换</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">进化材料分解：由高级材料分解为低级材料，<span style=\"color: rgb(255, 0, 0);\">高级材料分解比低级材料升级省钱</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">星云Boss挑战券：钻石兑换，不推荐</span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><br></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\">星云Boss挑战券分解：分解为1星、2星低级人偶材料，不推荐</span></div><div class=\"div-img\"><br></div><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/237792.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/237792.png\" style=\"width: 333px; height: 592px;\"></div><div class=\"div-img\"><div class=\"div-img\"><img data-width=\"720\" data-height=\"1280\" data-real=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/178394.png\" src=\"//cdnimg-v2.gamekee.com/wiki2.0/images/w_720/h_1280/1069/107851/2022/11/2/178394.png\" style=\"width: 333px; height: 592px;\"></div><br></div></div>\n                               </div><br>", "content_json": "", "content_cdn": "", "is_favorite": 0, "is_like": 0, "is_unlike": 0, "thumb_list": ["//cdnimg-v2.gamekee.com/wiki2.0/images/w_7