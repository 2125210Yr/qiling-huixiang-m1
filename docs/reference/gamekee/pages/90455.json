{"code": 0, "msg": "成功", "data": {"id": 90455, "game_id": 202, "entry_id": 63355, "uid": 63428, "type": 4, "title": "11月-12月日历分析", "tag": "0", "created_at": 1635076770, "updated_at": 1637597062, "updated_uid": 0, "comment_at": 1637597062, "last_at": 0, "comment_count": 36, "status": 1, "summary": "为保证信息时效性，Raid好友表已重置，请各位重新添加好友信息：https://docs.qq.com/sheet/DTklwSkxRUm92bm9Q?tab=BB08J2这期的日历信息量比较大，先是", "thumb": "//cdnimg-v2.gamekee.com/images/www/1636177179761_29552340.png", "model_ids": "", "like_count": 8, "unlike_count": 0, "view_count": 22806, "is_top": 0, "content_type": 0, "is_del": 0, "del_at": 0, "del_uid": 0, "is_release": 0, "source": 0, "last_ip_area": "", "is_prohibit_reply": 0, "is_only": 0, "state": 0, "audit_uid": 0, "favorite_count": 0, "seo": "", "video": "", "vote_ids": "", "is_elite": 0, "is_admin": 0, "audit_state": 0, "chat_game_id": 0, "is_image_text": 0, "from_chat": false, "chat_top": 0, "entry_auto": 1, "audit_at": 0, "server_id": 0, "image_num": 0, "video_list": "", "is_emulator": 0, "editor_type": 0, "ignore_hot": false, "mj_quote_num": 0, "mj_task_id": 0, "limit_age": 0, "important_at": 0, "is_expired": 0, "last_like_at": 0, "version": "", "word_count": 0, "content_id": 90455, "content": "<div class=\"div-img\"><br></div><div class=\"div-img\"><div class=\"div-img\"><div class=\"div-img\" style=\"color:rgb(0,0,0);font-size:14px;\"><span style=\"color:rgb(255,0,0);font-size:20px;\">为保证信息时效性，Raid好友表已重置，请各位重新添加好友信息：</span></div><span style=\"color:rgb(0,0,0);font-size:20px;\"><div class=\"div-img\" style=\"\"><span style=\"\"></span><span style=\"background:rgb(255,255,255);color:rgb(0,0,0);\">h</span><span style=\"background:rgb(255,255,255);color:rgb(0,0,0);\">ttps:<a href=\"http://docs.qq.com/sheet/DTklwSkxRUm92bm9Q?tab=BB08J2\" style=\"color:blue;background:transparent;\">//docs.qq.com/sheet/DTklwSkxRUm92bm9Q?tab=BB08J2</a></span></div></span><div class=\"div-img\" style=\"text-align: center;\"><img data-real=\"//cdnimg-v2.gamekee.com/images/www/1635145103647_98742036.png\" src=\"//cdnimg-v2.gamekee.com/images/www/1635145103647_98742036.png\"></div><br></div></div><span style=\"font-size: 20px;\"><div class=\"div-img\"><span style=\"font-weight: bold;\">这期的日历信息量比较大</span>，先是RagnaBurst开放，高难度PVE进阶模式。其次是娜塔莉丝<span style=\"\"></span>正式实装，双十一落地。无论哪里都写着两个字：充钱。</div><div class=\"div-img\"><span style=\"font-weight: bold;\">这还不是最重要的，说个冷知识：</span></div><div class=\"div-img\">日服的光自请妃＆鲤鱼王是作为叙事地下城实装的，当期剧情就是日历上的DUAL BLOCK BUSTER剧情，这意味着什么呢？蒙眼国际服以翻牌实装（日服不是翻牌），并且把光自请妃＆鲤鱼王登场的那期翻牌剧情给抢走了，导致她们俩没剧情出了。</div><div class=\"div-img\"><span style=\"font-weight: bold;\">?<span style=\"color: rgb(177, 56, 206);\">光自请妃＆鲤鱼王正式变成空降天子，随时空降骗氪。并且光自请妃还是新生代人权卡，强度和鲁邦平齐。氪，大力氪，氪十万！</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold; color: rgb(118, 146, 60);\"><span style=\"font-size: 24px;\">再换句话说：</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold; color: rgb(118, 146, 60);\"><span style=\"font-size: 24px;\">你在四人池造的孽，马上就要遭报应了，哈哈。钻石不够用，就后悔去吧。</span></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><span style=\"font-size: 24px; color: rgb(118, 146, 60);\">现在知道为什么这期四人质量这么高了吧？因为更强的来了。</span></span></div></span><div class=\"div-img\"></div><span style=\"font-size: 20px;\"><div class=\"div-img\"><div class=\"div-img\"><img data-real=\"//cdnimg-v2.gamekee.com/images/www/1635153092638_72430235.png\" src=\"//cdnimg-v2.gamekee.com/images/www/1635153092638_72430235.png\"></div><br></div><div class=\"div-img\"><br></div></span><div class=\"div-img\"><span style=\"font-size: 20px; font-weight: bold;\"><span style=\"font-size: 24px; background: rgb(255, 255, 255); color: rgb(0, 0, 0);\"><a href=\"http://docs.qq.com/sheet/DTklwSkxRUm92bm9Q?tab=BB08J2\" style=\"font-size:24px;background:transparent;color:blue;\"></a></span>后续活动：</span><span style=\"color: rgb(0, 176, 80); font-size: 20px; font-weight: 700;\">木Raid</span><span style=\"font-size: 20px; font-weight: 700;\">-</span><span style=\"font-size: 20px; font-weight: bold; color: rgb(215, 171, 81);\">光WB</span><span style=\"font-size: 20px; font-weight: bold;\">-</span><span style=\"font-size: 20px; font-weight: bold; color: rgb(0, 176, 80);\">木WB</span></div><div class=\"div-img\"><span style=\"font-size: 20px;\"><div class=\"div-img\"><div class=\"div-img\"><div class=\"div-img\"><img data-real=\"//cdnimg-v2.gamekee.com/images/www/1636177179761_29552340.png\" src=\"//cdnimg-v2.gamekee.com/images/www/1636177179761_29552340.png\"></div><br></div><br></div><br></span></div>", "content_json": "", "content_cdn": "", "is_favorite": 0, "is_like": 0, "is_unlike": 0, "thumb_list": ["//cdnimg-v2.gamekee.com/images/www/1636177179761_29552340.png"], "model_list": [], "user": {"uid": 63428, "username": "土星Saturn", "avatar": "//cdnimg-v2.gamekee.com/wiki2.0/images/w_600/h_600/202/63428/2023/0/12/382898.png", "description": "勇气带给我力量 希望带给我爱", "follow_num": 1398, "custom_tag": {"tag_name": "画饼王", "tag_color": "#F2AD18"}, "role_id": 2, "is_super": false, "status": 1, "is_followed": 0, "subscribe_num": 9, "content_at": 45063289, "content_num": 281, "read_num": 6803790, "like_num": 4765}, "update_user": {"uid": 0, "username": "", "avatar": "", "description": "", "follow_num": 0, "custom_tag": {"tag_name": "", "tag_color": ""}, "role_id": 0, "is_super": false, "status": 0, "is_followed": 0, "subscribe_num": 0, "content_at": 0, "content_num": 0, "read_num": 0, "like_num": 0}, "game": {"id": 202, "name": "天命之子", "icon": "//cdnimg-v2.gamekee.com/images/www/1600339074877_54241879.png?x-image-process=image/resize,m_lfit,h_250,w_250", "alias": "dc", "content_count": 7758, "follow_count": 14519}, "themes": null, "seo_format": {"title": "", "desc": "", "key": ""}, "video_format": {"cover": "", "video": "", "width": "", "height": "", "duration": 0, "video_compressed": ""}, "contributor": null, "vote_list": null, "ban_image_list": null, "is_strategy": false, "is_strategy_v1": false, "entry_data_bind": null, "entry_data_bind_c