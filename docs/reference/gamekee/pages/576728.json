: 0, "is_like": false}], "reward": {"user_count": 0, "last_user_list": null}, "content_tj_eq": {"content_id": 0, "content": "", "version": ""}, "content_tj_lineup": {"content_id": 0, "content": "", "content_1": "", "version": ""}, "content_tj_eq_cdn": "", "content_tj_lineup_cdn": "", "content_live_2d": "", "hot_content_strategies": [{"id": 75195, "name": "练角推荐评分表格", "icon": "", "jump_url": ""}, {"id": 588214, "name": "天命之子国际服天子修正前后对比图鉴（全）", "icon": "", "jump_url": ""}, {"id": 591546, "name": "纠缠的薇薇安", "icon": "", "jump_url": ""}, {"id": 58596, "name": "入坑攻略-从零开始的保姆向指南(下载\\选初始\\换绑定\\前期发展)", "icon": "", "jump_url": ""}], "related_strategies": [{"id": 593070, "name": "地狱地铁攻略", "icon": "//cdnimg-v2.gamekee.com/wiki2.0/images/w_250/h_250/202/63428/2023/4/5/213608.png", "jump_url": ""}, {"id": 590401, "name": "彩色附魔指南", "icon": "//cdnimg-v2.gamekee.com/wiki2.0/images/w_321/h_235/202/40642/2023/4/8/180646.png", "jump_url": ""}], "entry_pid": 120506}, "meta": {"request_id": "request:9e9ac4fb-d388-4a7a-b0c9-4400c992dd86", "trace_id": ""}}