con": "", "jump_url": ""}], "related_strategies": [{"id": 21573, "name": "转生馆介绍", "icon": "//cdnimg-v2.gamekee.com/images/dc/1577344970800_12095587.png?x-image-process=image/resize,m_lfit,h_150,w_150", "jump_url": ""}, {"id": 37396, "name": "装备加工系统介绍", "icon": "//cdnimg-v2.gamekee.com/images/dc/1591779449058_94983359.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 26610, "name": "魔王争霸战", "icon": "//cdnimg-v2.gamekee.com/images/dc/1583982761528_98130247.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 25568, "name": "温泉系统介绍", "icon": "//cdnimg-v2.gamekee.com/images/dc/1582701849536_65871265.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 62504, "name": "点火系统介绍", "icon": "//cdnimg-v2.gamekee.com/images/dc/1607504479909_47717210.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 90638, "name": "诸神强袭：炸裂 ", "icon": "//cdnimg-v2.gamekee.com/images/www/1635313541204_50500713.png", "jump_url": ""}], "entry_pid": 62013}, "meta": {"request_id": "request:5014977e-a710-4d19-8e7a-a667ae688985", "trace_id": ""}}