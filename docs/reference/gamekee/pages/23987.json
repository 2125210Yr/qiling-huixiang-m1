 ""}], "related_strategies": [{"id": 22249, "name": "新人引导", "icon": "//cdnimg-v2.gamekee.com/images/dc/1578297114621_20654107.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 22862, "name": "还魂推荐", "icon": "//cdnimg-v2.gamekee.com/images/dc/1579197754115_95226784.png?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 22251, "name": "西瓦WB", "icon": "//cdnimg-v2.gamekee.com/images/dc/1580577647901_98009314.jpg?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}, {"id": 22250, "name": "鲁茵RAID", "icon": "//cdnimg-v2.gamekee.com/images/dc/1580577597661_5715850.jpg?x-image-process=image/resize,m_lfit,h_250,w_250", "jump_url": ""}], "entry_pid": 21044}, "meta": {"request_id": "request:da1612a8-acef-4ef3-ad3b-c5b4554f41b9", "trace_id": "trace:d09e3fd7-e873-4f28-b1f6-40efac3c96d7"}}