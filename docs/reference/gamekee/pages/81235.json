ont-weight: bold;\"><span style=\"color: rgb(0, 38, 255);\"><span style=\"font-size: 20px;\"><br></span></span></span></div><div class=\"div-img\"><span style=\"font-weight: bold;\"><span style=\"color: rgb(0, 38, 255);\"><span style=\"font-size: 20px;\"><span style=\"color:rgb(0,0,0);font-size:24px;\"></span><span style=\"font-size: 20px;\"><span style=\"\"><span style=\"color: rgb(0, 0, 0);\">失败的朋友注意：方法2适用于</span><span style=\"color: rgb(255, 18, 18); font-weight: bold;\">安卓原版客户端+Line绑定的方式</span><span style=\"color: rgb(0, 0, 0);\">，TAP客户端未知，其他绑定方式，谷歌苹果等有别的更换方式。账号反正互通的</span></span></span><span style=\"color:rgb(0,0,0);font-size:24px;\"><span style=\"font-size: 20px;\"></span></span><br></span></span></span></div>", "content_json": "", "content_cdn": "", "is_favorite": 0, "is_like": 0, "is_unlike": 0, "thumb_list": ["//cdnimg-v2.gamekee.com/images/www/1624508331523_2909817.png"], "model_list": [], "user": {"uid": 40642, "username": "LaoTie101", "avatar": "//cdnimg-v2.gamekee.com/wiki2.0/avatar/1/9.png", "description": "天命之子群:587777772\nNIKKE500055101", "follow_num": 492, "custom_tag": {"tag_name": "榜1爱好者  ", "tag_color": "#00B0F0"}, "role_id": 2, "is_super": false, "status": 1, "is_followed": 0, "subscribe_num": 5, "content_at": 78705274, "content_num": 190, "read_num": 3668906, "like_num": 2223}, "update_user": {"uid": 40642, "username": "LaoTie101", "avatar": "//cdnimg-v2.gamekee.com/wiki2.0/avatar/1/9.png", "description": "天命之子群:587777772\nNIKKE500055101", "follow_num": 492, "custom_tag": {"tag_name": "", "tag_color": ""}, "role_id": 0, "is_super": false, "status": 1, "is_followed": 0, "subscribe_num": 5, "content_at": 0, "content_num": 0, "read_num": 0, "like_num": 0}, "game": {"id": 202, "name": "天命之子", "icon": "//cdnimg-v2.gamekee.com/images/www/1600339074877_54241879.png?x-image-process=image/resize,m_lfit,h_250,w_250", "alias": "dc", "content_count": 7758, "follow_count": 14519}, "themes": null, "seo_format": {"title": "", "desc": "", "key": ""}, "video_fo