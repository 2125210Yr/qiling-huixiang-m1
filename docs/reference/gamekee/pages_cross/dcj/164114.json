": 166850, "game_id": 1164, "content_id": 164114, "img": "", "html": "<div data-col=\"2\" class=\"selectItem mould-table-wrap auto-size-table\" contenteditable=\"false\" model-id=\"166850\" data-insertcount=\"0\">\n                                \n                                <div class=\"table-container\">\n                                  <div class=\"table-overflow\">\n                                    \n                                    \n                                    \n                                    <table class=\"mould-table selectItemTable col-group-table\" style=\"width: 473px;\">\n                                      <colgroup><col style=\"width: 62px;\"><col style=\"width: 411px;\"></colgroup>\n                                      <tbody>\n                                        \n                                      <tr style=\"height: 41px;\"><td class=\"\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">自动攻击</div></td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">造成<span style=\"color: rgb(0, 176, 240);\">606点伤害</span></div></td></tr><tr style=\"height: 43px;\"><td class=\"\">\n                    <div style=\"min-height: 20px; width: auto;\" class=\"td\">自动（u）</div>\n                  </td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height:20px;width:auto;\" class=\"td\">造成<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">691点伤害</span></div></td></tr><tr style=\"height: 62px;\"><td class=\"\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">ns</div></td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">造成<span style=\"color: rgb(0, 176, 240);\">1925点伤害</span>，气绝中的队友优先，95.1%的概率使<span style=\"color: rgb(0, 176, 240);\">两名队友</span>在10秒间气绝和强打无效。20人boss战时，<span style=\"color: rgb(0, 176, 240);\">85%</span>的概率使火属性攻击力最高的<span style=\"color: rgb(0, 176, 240);\">两名队友</span>冷却时间结束</div></td></tr><tr style=\"height: 81px;\"><td class=\"\">\n                    <div style=\"min-height: 20px; width: auto;\" class=\"td\">ns(u)</div>\n                  </td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height:20px;width:auto;\" class=\"td\">造成<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">2614点伤害</span>，气绝中的队友优先，95.1%的概率使<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">三名队友</span>在10秒间气绝和强打无效。20人boss战时，<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">90%</span>的概率使火属性攻<span style=\"font-size: 0.37333rem;\">击力最高的<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">三名队友</span>冷却时间结束</span></div></td></tr><tr style=\"height: 81px;\"><td><div style=\"min-height: 20px; width: auto;\" class=\"td\">ss</div></td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">随机对两名敌人造成<span style=\"color: rgb(0, 176, 240);\">3055点伤害</span>，<span style=\"color: rgb(0, 176, 240);\">2回合间90%</span>的概率使火属性攻击力最高的<span style=\"color: rgb(0, 176, 240);\">两名队友</span>应援（弱点技能伤害增加15%，根据现在的buff数增加攻击力），20人boss战的时候，使火属性攻击力最高的五名队友<span style=\"color: rgb(0, 176, 240);\">2回合间</span>气合（<span style=\"color: rgb(0, 176, 240);\">攻击力加35.1%</span>，最高可叠加3次）</div></td></tr><tr style=\"height: 81px;\"><td class=\"\">\n                    <div style=\"min-height: 20px; width: auto;\" class=\"td\">ss(u)</div>\n                  </td><td class=\"\">\n                    <div style=\"text-align: left; min-height: 20px; width: auto;\" class=\"td\">随机对两名敌人造成<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">4186点伤害</span>，<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">3回合间95.1%</span>的概率使火属性攻击力最高的<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">三名队友</span>应援（弱点技能伤害增加15%，根据现在的buff数增加攻击力），20人boss战的时候，使火属性攻击力最高的五名队友<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">3回合</span>间气合（<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">攻击力加40.1%</span>，最高可叠加3次）</div>\n                  </td></tr><tr style=\"height: 62px;\"><td><div style=\"min-height: 20px; width: auto;\" class=\"td\">ds</div></td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">&nbsp;随机对三名敌人造成<span style=\"color: rgb(0, 176, 240);\">4661的伤害</span>，80%的概率使火属性攻击力最高的五名队友冷却时间结束，20人boss战的时候，使3名火属性的攻击型队友在<span style=\"color: rgb(0, 176, 240);\">2回合间</span>集中（命中率增加。必定暴击）</div></td></tr><tr style=\"height: 62px;\"><td class=\"\">\n                    <div style=\"min-height: 20px; width: auto;\" class=\"td\">ds(u)</div>\n                  </td><td class=\"\">\n                    <div style=\"text-align: left; min-height: 20px; width: auto;\" class=\"td\">&nbsp;随随机对三名敌人造成<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">7372的伤害</span>，80%的概率使火属性攻击力最高的五名队友冷却时间结束，20人boss战的时候，使3名火属性的攻击型队友在<span style=\"color: rgb(255, 0, 0); font-weight: bold;\">3回合间集中</span>（命中率增加。必定暴击）</div>\n                  </td></tr><tr style=\"height: 41px;\"><td><div style=\"min-height: 20px; width: auto;\" class=\"td\">队长技</div></td><td class=\"\" style=\"text-align: left;\"><div style=\"min-height: 20px; width: auto;\" class=\"td\">火属性队友暴击伤害增加20%（20人boss战时追加30%）</div></td></tr></tbody>\n                                    </table>\n                                  </div>\n                                </div>\n                            </div>", "table_data": "[]", "status": 1, "uid": 0, "is_img": 0, "created_at": 1659684863, "updated_at": 1659728992}], "user": {"uid": 176744, "username": "咸鱼老四", "avatar": "//cdnimg-v2.gamekee.com/wiki2.0/avatar/1/22.png", "description": "", "follow_num": 1, "custom_tag": {"tag_name": "", "tag_color": ""}, "role_id": 2, "is_super": false, "status": 1, "is_followed": 0, "subscribe_num": 1, "content_at": 123152468, "content_num": 45, "read_num": 135545, "like_num": 59}, "update_user": {"uid": 176744, "username": "咸鱼老四", "avatar": "//cdnimg-v2.gamekee.com/wiki2.0/avatar/1/22.png", "description": "", "follow_num": 1